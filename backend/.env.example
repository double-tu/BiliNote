
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8000
SCREENSHOT_BASE_URL=http://127.0.0.1:8000/static/screenshots
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL
DATA_DIR=data
# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou/groq/openai-compatible/qwen/doubao
WHISPER_MODEL_SIZE=base

# Windows 可填写 ffmpeg.exe 的绝对路径，或包含 ffmpeg.exe 的 bin 目录
FFMPEG_BIN_PATH=

# 原生云端 ASR（实际 API Key 请在前端「模型供应商」中配置）
QWEN_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 按百炼地域可改为 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_ASR_FILE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_ASR_MAX_FILE_MB=10
DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCENGINE_RESOURCE_ID=volc.seedasr.sauc.duration
